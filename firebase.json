{
  "hosting": {
    "public": "dist/web",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/bridge.html",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors chrome-extension://bjalnnabhfhgfbpbabahhaiapjjhpheh"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "remoteconfig": {
    "template": "remoteconfig.template.json"
  }
}
