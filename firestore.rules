rules_version = '2';
// Only one collection: reports/{sha256 of a site name} = { count, last }.
// No message text and no user data is ever stored.
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{hash} {
      allow read: if hash.matches('^[0-9a-f]{64}$');
      allow create: if request.auth != null
        && hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['count', 'last'])
        && request.resource.data.count == 1
        && request.resource.data.last == request.time;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['count', 'last'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.last == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
